# Copy this file to .env.local. Ollama runs locally and needs no API key.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_DEMO_MODE=false

# Optional hosted providers (real provider keys may incur charges):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=put-your-real-key-here
#
# LLM_PROVIDER=openrouter
# LLM_MODEL=provider/model-name
# OPENROUTER_API_KEY=put-your-real-key-here
#
# LM Studio is another local, no-key option:
# LLM_PROVIDER=lmstudio
# LLM_MODEL=your-loaded-model-id
# LLM_BASE_URL=http://127.0.0.1:1234/v1

# Local MySQL development settings. Use a dedicated DB user outside local practice.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=genai_chat_practice
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password
COOKIE_SECURE=false
